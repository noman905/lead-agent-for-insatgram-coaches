# Google Sheets Credentials Configuration
# Path to your Google Service Account JSON key file (e.g. credentials.json or service_account.json)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

# Your Google Sheet ID (from the URL: https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit)
# Or full spreadsheet title if accessible by the service account
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Apify API Token (from https://console.apify.com/account/integrations)
APIFY_API_TOKEN=your_apify_api_token_here

# AI Model APIs for Gender Pre-Filter (Tier 2)
# Groq API Key (Free — get from console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Free — get from aistudio.google.com/app/apikey)
# Note: New keys start with AQ.Ab format — this is correct and valid
GEMINI_API_KEY=your_gemini_api_key_here

# Email Notification Credentials (SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_ADDRESS=your_gmail_address@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password
RECIPIENT_EMAIL=your_recipient_email@gmail.com
